# ========================================================
# AI Meeting Recorder - Environment Configuration Template
# ========================================================

# 1. Gemini AI API Key (Required for Transcription & Summary)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MySQL Configuration (Optional - Defaults to local SQLite if left blank)
# Option A: Discrete Connection Parameters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_crm_user
MYSQL_PASSWORD=your_crm_password
MYSQL_DATABASE=ai_meeting_recorder
MYSQL_SSL=false

# Option B: Full MySQL Connection URL (Overrides Option A if set)
# DATABASE_URL=mysql://your_crm_user:your_crm_password@localhost:3306/ai_meeting_recorder
